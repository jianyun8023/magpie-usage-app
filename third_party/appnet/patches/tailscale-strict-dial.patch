+// DialStrict connects only through this server's userspace netstack. Names are
+// resolved only from the current netmap (MagicDNS); unknown names and non-peer
+// addresses never fall back to the system network.
+func (s *Server) DialStrict(ctx context.Context, network, address string) (net.Conn, error) {
+	if err := s.Start(); err != nil {
+		return nil, err
+	}
+	if err := s.awaitRunning(ctx); err != nil {
+		return nil, err
+	}
+	return s.dialer.StrictUserDial(ctx, network, address)
+}
